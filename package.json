    "@fastify/swagger-ui": "^6.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  }
}
